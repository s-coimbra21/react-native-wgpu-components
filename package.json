{
  "name": "react-native-wgpu-components-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for react-native-wgpu-components: GPU-accelerated UI components for React Native (iOS, Android, Web).",
  "repository": {
    "type": "git",
    "url": "https://github.com/s-coimbra21/react-native-wgpu-components.git"
  },
  "scripts": {
    "build": "pnpm --filter react-native-wgpu-components build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "example": "pnpm --filter wgpu-components-example start",
    "ios": "pnpm --filter wgpu-components-example ios",
    "android": "pnpm --filter wgpu-components-example android",
    "web": "pnpm --filter wgpu-components-example web",
    "docs:dev": "pnpm --filter wgpu-components-docs dev",
    "docs:build": "pnpm --filter wgpu-components-docs build"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.12.0"
}
